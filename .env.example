# =============================================================================
# NossoCRM - Variaveis de Ambiente
# =============================================================================
# Copie para .env.local e preencha com seus valores.
# NAO coloque segredos aqui.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://nossocrm:nossocrm123@localhost:5432/nossocrm

# --- Autenticacao (NextAuth.js) ---
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=http://minio.local:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DEAL_FILES=deal-files
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_AUDIO_NOTES=audio-notes
MINIO_USE_SSL=false

# --- Dev-only ---
# Habilita rotas internas de teste de IA em desenvolvimento.
ALLOW_AI_TEST_ROUTE=false

# Habilita rotas internas de mock de UI em desenvolvimento.
ALLOW_UI_MOCKS_ROUTE=false
