// -----------------------------------------------------------------------------
// 26. AUDIT_LOGS
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  details        Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")
  severity       String   @default("info") // debug, info, warning, error, critical

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 27. SECURITY_ALERTS
// -----------------------------------------------------------------------------

model SecurityAlert {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  alertType      String    @map("alert_type") @db.VarChar(50)
  severity       String    @default("warning") @db.VarChar(20)
  title          String    @db.VarChar(255)
  description    String?
  details        Json?
  userId         String?   @map("user_id") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation("SecurityAlertUser", fields: [userId], references: [id], onDelete: SetNull)
  acknowledger User?         @relation("SecurityAlertAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: SetNull)

  @@map("security_alerts")
}

// =============================================================================
// API KEYS
