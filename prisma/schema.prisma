// -----------------------------------------------------------------------------
// DEAL_NOTES
// -----------------------------------------------------------------------------

model DealNote {
  id        String   @id @default(uuid()) @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  creator Profile? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([createdAt(sort: Desc)])
  @@map("deal_notes")
}

// -----------------------------------------------------------------------------
// DEAL_FILES
// -----------------------------------------------------------------------------

model DealFile {
  id        String   @id @default(uuid()) @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  creator Profile? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@map("deal_files")
}

// -----------------------------------------------------------------------------
// QUICK_SCRIPTS
// -----------------------------------------------------------------------------

model QuickScript {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  category  String   // followup, objection, closing, intro, rescue, other
  template  String
  icon      String   @default("MessageSquare")
  isSystem  Boolean  @default(false) @map("is_system")
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("quick_scripts")
}

// =============================================================================
// INTEGRATIONS / WEBHOOKS
// =============================================================================

model IntegrationInboundSource {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @default("Entrada de Leads")
  entryBoardId   String   @map("entry_board_id") @db.Uuid
  entryStageId   String   @map("entry_stage_id") @db.Uuid
  secret         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryBoard   Board        @relation(fields: [entryBoardId], references: [id])
  entryStage   BoardStage   @relation("InboundEntryStage", fields: [entryStageId], references: [id])

  webhookEventsIn WebhookEventIn[]

  @@map("integration_inbound_sources")
}

model IntegrationOutboundEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @default("Follow-up (Webhook)")
  url            String
  secret         String
  events         String[] @default(["deal.stage_changed"])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookDeliveries WebhookDelivery[]

  @@map("integration_outbound_endpoints")
}

model WebhookEventIn {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  sourceId         String   @map("source_id") @db.Uuid
  provider         String   @default("generic")
  externalEventId  String?  @map("external_event_id")
  payload          Json     @default("{}")
  status           String   @default("received")
  error            String?
  createdContactId String?  @map("created_contact_id") @db.Uuid
  createdDealId    String?  @map("created_deal_id") @db.Uuid
  receivedAt       DateTime @default(now()) @map("received_at")

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         IntegrationInboundSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdContact Contact?                  @relation("WebhookCreatedContact", fields: [createdContactId], references: [id], onDelete: SetNull)
  createdDeal    Deal?                     @relation("WebhookCreatedDeal", fields: [createdDealId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalEventId])
  @@map("webhook_events_in")
}

model WebhookEventOut {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      String   @map("event_type")
  payload        Json     @default("{}")
  dealId         String?  @map("deal_id") @db.Uuid
  fromStageId    String?  @map("from_stage_id") @db.Uuid
  toStageId      String?  @map("to_stage_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  fromStage    BoardStage?  @relation("WebhookFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage      BoardStage?  @relation("WebhookToStage", fields: [toStageId], references: [id], onDelete: SetNull)

  deliveries WebhookDelivery[]

  @@map("webhook_events_out")
}

model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  endpointId     String   @map("endpoint_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  requestId      BigInt?  @map("request_id")
  status         String   @default("queued")
  attemptedAt    DateTime @default(now()) @map("attempted_at")
  responseStatus Int?     @map("response_status")
  error          String?

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint     IntegrationOutboundEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        WebhookEventOut              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}
