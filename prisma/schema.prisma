model RateLimit {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  endpoint   String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, endpoint, createdAt(sort: Desc)])
  @@map("rate_limits")
}

// -----------------------------------------------------------------------------
// 25. USER_CONSENTS (LGPD)
// -----------------------------------------------------------------------------

model UserConsent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  consentType String    @map("consent_type") // terms, privacy, marketing, analytics, data_processing, AI_CONSENT
  version     String
  consentedAt DateTime  @default(now()) @map("consented_at")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  revokedAt   DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
