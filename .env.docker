# =============================================================================
# NossoCRM - Environment Variables (Docker/Self-Hosted)
# =============================================================================
# Copy to .env and fill with your values.

# --- Database ---
DATABASE_URL=postgresql://nossocrm:nossocrm123@postgres:5432/nossocrm
DB_PASSWORD=nossocrm123

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=http://minio.local:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DEAL_FILES=deal-files
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_AUDIO_NOTES=audio-notes
MINIO_USE_SSL=false

# --- Dev-only ---
ALLOW_AI_TEST_ROUTE=false
ALLOW_UI_MOCKS_ROUTE=false
